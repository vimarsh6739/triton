module {
  tt.func public @kernel(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: f32, %arg3: i32, %arg4: f32) {
    %cst = arith.constant 0.000000e+00 : f32
    %c0_i32 = arith.constant 0 : i32
    %c1_i32 = arith.constant 1 : i32
    %c2048_i32 = arith.constant 2048 : i32
    %0 = tt.get_program_id x : i32
    %1 = arith.muli %0, %c2048_i32 : i32
    %2 = tt.splat %1 : i32 -> tensor<2048xi32>
    %3 = tt.make_range {end = 2048 : i32, start = 0 : i32} : tensor<2048xi32>
    %4 = arith.addi %2, %3 : tensor<2048xi32>
    %5 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<2048x!tt.ptr<f32>>
    %6 = tt.addptr %5, %4 : tensor<2048x!tt.ptr<f32>>, tensor<2048xi32>
    %7 = tt.load %6 : tensor<2048x!tt.ptr<f32>>
    %8:2 = scf.for %arg5 = %c0_i32 to %arg3 step %c1_i32 iter_args(%arg6 = %arg4, %arg7 = %cst) -> (f32, f32)  : i32 {
      %13 = arith.addf %arg7, %arg6 fastmath<fast> : f32
      %14 = arith.mulf %arg6, %arg2 fastmath<fast> : f32
      scf.yield %14, %13 : f32, f32
    }
    %9 = tt.splat %8#1 : f32 -> tensor<2048xf32>
    %10 = arith.mulf %9, %7 fastmath<fast> : tensor<2048xf32>
    %11 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<2048x!tt.ptr<f32>>
    %12 = tt.addptr %11, %4 : tensor<2048x!tt.ptr<f32>>, tensor<2048xi32>
    tt.store %12, %10 : tensor<2048x!tt.ptr<f32>>
    tt.return
  }
}

